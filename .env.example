# Companies House public data API key (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Where the SQLite database lives
RADAR_DB=./data/radar.sqlite

# Optional: POST critical/high alerts as JSON to this URL (Slack/Teams incoming webhook, Zapier, etc.)
ALERT_WEBHOOK_URL=

# Optional: minimum alert severity to send to the webhook (critical | high | medium | info)
ALERT_WEBHOOK_MIN_SEVERITY=high

# Optional: HTTP port for the dashboard
PORT=8787

# Optional: how many months of Gazette history to scan per company (default 24)
GAZETTE_LOOKBACK_MONTHS=24
